# 웹서버(Caddy) 설정 — 서버 IP로 접속하는 HTTPS (Task 18).
# 설치 위치: /etc/caddy/Caddyfile
#
# 상태: 파일만 준비했고 **서버에서 아직 실행해 보지 않았다**(2026-11-19). 결과는 deploy/web-server-notes.md에 적는다.
#
# 서버 IP는 이 파일에 적지 않는다(저장소에 서버 주소를 두지 않는다). `{$LABOR_SERVER_IP}`는 Caddy가 시작할 때 환경 변수에서
# 채운다. 서버의 /etc/systemd/system/caddy.service.d/ 에 Environment=LABOR_SERVER_IP=… 를 두는 방식이다(서버에서만 만든다).
#
# 하는 일: 80·443을 받아서 (1) /api/* 는 127.0.0.1:8000(uvicorn)으로 넘기고 (2) 나머지는 빌드된 화면 파일(frontend/dist)을 준다.

{$LABOR_SERVER_IP} {
	# IP 주소 인증서: Let's Encrypt는 IP 인증서를 160시간짜리(shortlived 프로파일)로만 준다(2026-01-15 정식 제공,
	# letsencrypt.org/2026/01/15/6day-and-ip-general-availability). 그래서 ACME 발급자에 profile을 명시한다.
	# 증명은 80번 포트의 http-01(또는 tls-alpn-01)로 한다 — IP는 DNS 방식 증명을 쓸 수 없다. 그래서 80번 포트가 열려 있어야 한다.
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}

	# 응답 헤더. HSTS는 넣지 않았다: 인증서가 6일마다 갱신되어야 하는데 갱신이 어긋나는 순간 브라우저가 접속 자체를 막아 버린다.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	# API: 요청 본문은 32KB까지만 받는다. 앱은 질문 글자 수(1,000자)만 제한하고 본문 크기는 제한하지 않으므로(Task 14 판정)
	# 여기서 막는다. 한글은 글자당 3바이트라 1,000자 질문 + JSON 포장이 약 3.1KB다.
	handle /api/* {
		request_body {
			max_size 32KB
		}
		reverse_proxy 127.0.0.1:8000 {
			# SSE(답변 흘려보내기)를 모아 두지 않고 바로 내보낸다.
			flush_interval -1
		}
	}

	# 그 밖의 주소는 화면 파일. 없는 경로는 index.html로(화면 안의 주소 이동을 화면이 처리한다).
	handle {
		root * /opt/labor-rag/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
