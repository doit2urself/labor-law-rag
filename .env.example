# 서버의 .env에 이 이름들로 값을 넣는다. 이 파일에는 값을 적지 않는다(비밀번호·키는 저장소에 두지 않는다).
# 모든 이름은 LABOR_ 접두어를 쓴다. 값 없이 비워 둔 것이 필수 항목이다.

# --- 필수 ---
LABOR_LAW_API_OC=
LABOR_GEMINI_API_KEY=
LABOR_COHERE_API_KEY=
# bcrypt 해시만 넣는다. scripts/make_password_hash.py로 만든다(비밀번호 원문은 어디에도 적지 않는다).
LABOR_ADMIN_PASSWORD_HASH=
LABOR_TEST_PASSWORD_HASH=
LABOR_SESSION_SECRET=
LABOR_LANGFUSE_PUBLIC_KEY=
LABOR_LANGFUSE_SECRET_KEY=
LABOR_LANGFUSE_HOST=

# --- 선택 (기본값을 바꾸고 싶을 때만 주석을 풀어 쓴다) ---
# LABOR_OPENSEARCH_URL=http://127.0.0.1:9200
# LABOR_INDEX_NAME=labor-rag-v1
# LABOR_SQLITE_PATH=data/app.db
# LABOR_LLM_MODEL=gemini-3.5-flash-lite
# LABOR_SEARCH_DEPTH=150
# LABOR_RERANK_MIN_SCORE=0.0
# LABOR_RERANK_MONTHLY_CAP=950
# LABOR_TEST_IP_LIMIT=5
# 목록 값은 JSON 형식으로 쓴다. 예: LABOR_TRUSTED_PROXIES=["127.0.0.1"]
