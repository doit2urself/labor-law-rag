# 서버의 .env에 이 이름들로 값을 넣는다. 이 파일에는 값을 적지 않는다(비밀번호·키는 저장소에 두지 않는다).
# 모든 이름은 LABOR_ 접두어를 쓴다. 값 없이 비워 둔 것이 필수 항목이다.
# 서버에서는 이 파일을 /opt/labor-rag/.env 로 복사해 채운다(소유자 labor, 권한 600). 앱이 작업 폴더의 .env를 직접 읽는다.

# --- 필수 ---
LABOR_GEMINI_API_KEY=
LABOR_COHERE_API_KEY=
# OpenSearch admin 비밀번호: 서버에 OpenSearch를 설치할 때 사용자가 직접 정한 값(채팅·저장소에 적지 않는다).
LABOR_OPENSEARCH_PASSWORD=
# bcrypt 해시만 넣는다. scripts/make_password_hash.py로 만든다(비밀번호 원문은 어디에도 적지 않는다).
# 출력된 한 줄을 그대로 붙여 넣는다: LABOR_ADMIN_PASSWORD_HASH='$2b$12$…' (작은따옴표 포함, `$` 때문).
LABOR_ADMIN_PASSWORD_HASH=
LABOR_TEST_PASSWORD_HASH=
# 로그인 쿠키의 서명 비밀: 아무도 추측할 수 없는 긴 무작위 문자열(예: 서버에서 `openssl rand -hex 32`로 만든 값).
# 이 값이 바뀌면 지금 로그인해 있는 모든 사람이 로그아웃된다.
LABOR_SESSION_SECRET=
LABOR_LANGFUSE_PUBLIC_KEY=
LABOR_LANGFUSE_SECRET_KEY=
LABOR_LANGFUSE_HOST=

# --- 선택 (기본값을 바꾸고 싶을 때만 주석을 풀어 쓴다) ---
# 법제처 Open API 인증값: v1은 API를 쓰지 않고 파일로 수집하므로 비워 둬도 된다(scripts/collect.py를 쓸 때만 필요).
# LABOR_LAW_API_OC=
# LABOR_OPENSEARCH_URL=https://127.0.0.1:9200
# LABOR_OPENSEARCH_USER=admin
# LABOR_INDEX_NAME=labor-rag-v1
# LABOR_SQLITE_PATH=data/app.db
# 대화 체크포인트 파일(앱 DB와 따로). scripts/prune_checkpoints.py의 기본 대상과 같은 경로다.
# LABOR_CHECKPOINT_PATH=data/checkpoints.db
# LABOR_LLM_MODEL=gemini-3.1-flash-lite
# LABOR_SEARCH_DEPTH=100
# LABOR_RERANK_MIN_SCORE=0.15
# LABOR_RERANK_MONTHLY_CAP=950
# LABOR_TEST_IP_LIMIT=5
# 목록 값은 JSON 형식으로 쓴다. 예: LABOR_TRUSTED_PROXIES=["127.0.0.1"]
